    (require-any (literal (param "WRITE_DENY_0")) (subpath (param "WRITE_DENY_0")))
    (require-not (literal "/dev/null"))
    (require-not (literal "/dev/tty"))
    (require-not (literal "/dev/ptmx"))
    (require-not (literal "/dev/fd"))
    (require-not (subpath "/dev/fd"))
    (require-not (regex #"^/dev/(tty|pty)[A-Za-z0-9]+$"))
    (require-not (literal (param "DARWIN_RUNTIME_TMPDIR")))
    (require-not (subpath (param "DARWIN_RUNTIME_TMPDIR")))
    (require-not (literal (param "WRITE_DENY_0_REOPEN_0")))
    (require-not (subpath (param "WRITE_DENY_0_REOPEN_0")))
  ))

(deny file-write*
  (require-all
    (require-any (literal (param "WRITE_DENY_1")) (subpath (param "WRITE_DENY_1")))
  ))

(deny file-write*
  (require-all
    (require-any (literal (param "WRITE_DENY_2")) (subpath (param "WRITE_DENY_2")))
    (require-not (literal (param "WRITE_DENY_2_REOPEN_0")))
    (require-not (subpath (param "WRITE_DENY_2_REOPEN_0")))
  ))

(deny file-write*
  (require-all
    (require-any (literal (param "WRITE_DENY_3")) (subpath (param "WRITE_DENY_3")))
  ))

(deny file-write*
  (require-all
    (require-any (literal (param "WRITE_DENY_4")) (subpath (param "WRITE_DENY_4")))
  ))

(deny file-write*
  (require-all
    (require-any (literal (param "WRITE_DENY_5")) (subpath (param "WRITE_DENY_5")))
  ))

(deny file-write*
  (require-all
    (require-any (literal (param "WRITE_DENY_6")) (subpath (param "WRITE_DENY_6")))
  ))

(deny file-write*
  (require-all
    (require-any (literal (param "WRITE_DENY_7")) (subpath (param "WRITE_DENY_7")))
  ))

(deny file-write*
  (require-all
    (require-any (literal (param "WRITE_DENY_8")) (subpath (param "WRITE_DENY_8")))
  ))

(deny file-write*
  (require-all
    (require-any (literal (param "WRITE_DENY_9")) (subpath (param "WRITE_DENY_9")))
  ))

(deny file-write*
  (require-all
    (require-any (literal (param "WRITE_DENY_10")) (subpath (param "WRITE_DENY_10")))
  ))

(deny file-write*
  (require-all
    (require-any (literal (param "WRITE_DENY_11")) (subpath (param "WRITE_DENY_11")))
  ))

(deny file-read*
  (require-all
    (require-any (literal (param "READ_DENY_0")) (subpath (param "READ_DENY_0")))
  ))

(deny network-outbound
  (remote unix-socket
    (require-all
      (require-any (literal (param "READ_DENY_0")) (subpath (param "READ_DENY_0")))
    )))

(deny file-read*
  (require-all
    (require-any (literal (param "READ_DENY_1")) (subpath (param "READ_DENY_1")))
    (require-not (literal (param "READ_DENY_1_REOPEN_0")))
    (require-not (subpath (param "READ_DENY_1_REOPEN_0")))
  ))

(deny network-outbound
  (remote unix-socket
    (require-all
      (require-any (literal (param "READ_DENY_1")) (subpath (param "READ_DENY_1")))
      (require-not (literal (param "READ_DENY_1_REOPEN_0")))
      (require-not (subpath (param "READ_DENY_1_REOPEN_0")))
    )))

(deny file-read*
  (require-all
    (require-any (literal (param "READ_DENY_2")) (subpath (param "READ_DENY_2")))
  ))

(deny network-outbound
  (remote unix-socket
    (require-all
      (require-any (literal (param "READ_DENY_2")) (subpath (param "READ_DENY_2")))
    )))

(deny file-read*
  (require-all
    (require-any (literal (param "READ_DENY_3")) (subpath (param "READ_DENY_3")))
  ))

(deny network-outbound
  (remote unix-socket
    (require-all
      (require-any (literal (param "READ_DENY_3")) (subpath (param "READ_DENY_3")))
    )))

(deny file-read*
  (require-all
    (require-any (literal (param "READ_DENY_4")) (subpath (param "READ_DENY_4")))
  ))

(deny network-outbound
  (remote unix-socket
    (require-all
      (require-any (literal (param "READ_DENY_4")) (subpath (param "READ_DENY_4")))
    )))

; Protected-root ancestors cannot be renamed or removed.
(deny file-write-unlink
  (require-any
    (literal (param "PROTECTED_ANCESTOR_0"))
    (literal (param "PROTECTED_ANCESTOR_1"))
    (literal (param "PROTECTED_ANCESTOR_2"))
    (literal (param "PROTECTED_ANCESTOR_3"))
    (literal (param "PROTECTED_ANCESTOR_4"))
    (literal (param "PROTECTED_ANCESTOR_5"))
    (literal (param "PROTECTED_ANCESTOR_6"))
  ))
' -DAGENTD_SOCKET_0=$ROOT/home/.tclaude-agentd.sock -DAGENTD_SOCKET_1=$ROOT/home/.tclaude/agentd.sock -DAGENTD_SOCKET_2=$ROOT/home/.tclaude/api/agentd.sock -DAGENTD_SOCKET_3=$ROOT/pin.sock -DWRITE_DENY_0=/ -DDARWIN_RUNTIME_TMPDIR=/private/var/folders/ab/runtime/T -DWRITE_DENY_0_REOPEN_0=/private/tmp -DWRITE_DENY_1=$ROOT/extra/hide -DWRITE_DENY_2=$ROOT/extra/private -DWRITE_DENY_2_REOPEN_0=$ROOT/extra/private/current -DWRITE_DENY_3=$ROOT/extra/ro -DWRITE_DENY_4=$ROOT/home/.claude/sessions -DWRITE_DENY_5=$ROOT/home/.tclaude-agentd.sock -DWRITE_DENY_6=$ROOT/home/.tclaude/agentd.sock -DWRITE_DENY_7=$ROOT/home/.tclaude/api/agentd-socket -DWRITE_DENY_8=$ROOT/home/.tclaude/api/agentd.sock -DWRITE_DENY_9=$ROOT/home/.tclaude/data -DWRITE_DENY_10=$ROOT/pin.sock -DWRITE_DENY_11=$ROOT/tmux/tmux-$UID -DREAD_DENY_0=$ROOT/extra/hide -DREAD_DENY_1=$ROOT/extra/private -DREAD_DENY_1_REOPEN_0=$ROOT/extra/private/current -DREAD_DENY_2=$ROOT/home/.claude/sessions -DREAD_DENY_3=$ROOT/home/.tclaude/data -DREAD_DENY_4=$ROOT/tmux/tmux-$UID -DPROTECTED_ANCESTOR_0=/private -DPROTECTED_ANCESTOR_1=/private/tmp -DPROTECTED_ANCESTOR_2=$ROOT -DPROTECTED_ANCESTOR_3=$ROOT/extra -DPROTECTED_ANCESTOR_4=$ROOT/home -DPROTECTED_ANCESTOR_5=$ROOT/home/.claude -DPROTECTED_ANCESTOR_6=$ROOT/home/.tclaude -- /bin/bash -p -c 'exec opencode serve'
