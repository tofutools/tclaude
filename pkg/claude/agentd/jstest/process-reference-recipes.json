{
 "cases": {
  "simple": {
   "template": {
    "apiVersion": "tclaude.dev/v1alpha1",
    "kind": "ProcessTemplate",
    "id": "",
    "name": "Simple implementation",
    "params": {
     "idea": {
      "type": "string",
      "required": true,
      "description": "The idea to build"
     },
     "auto_merge": {
      "type": "boolean",
      "default": false,
      "description": "Merge on green CI without asking"
     }
    },
    "start": "start",
    "nodes": {
     "start": {
      "type": "start"
     },
     "end": {
      "type": "end"
     },
     "discuss-the-idea": {
      "type": "task",
      "name": "Discuss the idea",
      "performer": {
       "kind": "agent",
       "prompt": "Discuss {{params.idea}} with the operator until the high-level idea is clear. Write it down.",
       "lead": true
      }
     },
     "idea-decided": {
      "type": "decision",
      "name": "Idea decided",
      "performer": {
       "kind": "human",
       "ask": "Is the high-level idea decided?",
       "choices": [
        "decided",
        "not-yet"
       ]
      },
      "loops": {
       "not-yet": {
        "maxIterations": 3
       }
      }
     },
     "provision-an-implementor": {
      "type": "task",
      "name": "Provision an implementor",
      "performer": {
       "kind": "agent",
       "prompt": "Bring in an implementor for the idea and brief it.",
       "lead": true
      }
     },
     "build-the-feature": {
      "type": "task",
      "name": "Build the feature",
      "performer": {
       "kind": "agent",
       "prompt": "Build the agreed idea on a branch and open a draft PR.",
       "role": "implementor"
      }
     },
     "cold-review": {
      "type": "task",
      "name": "Cold review",
      "performer": {
       "kind": "agent",
       "prompt": "Review the PR cold, as someone who did not build it. List what you find.",
       "anyone": true,
       "differentFrom": [
        "build-the-feature"
       ]
      }
     },
     "iterate-or-move-on": {
      "type": "decision",
      "name": "Iterate or move on",
      "performer": {
       "kind": "agent",
       "prompt": "Does the review warrant another round of changes, or does it move ahead?",
       "lead": true
      },
      "loops": {
       "iterate": {
        "maxIterations": 3,
        "onExhausted": "give-up"
       }
      }
     },
     "gave-up": {
      "type": "end",
      "name": "Gave up",
      "result": "failed"
     },
     "ready-the-pr": {
      "type": "task",
      "name": "Ready the PR",
      "performer": {
       "kind": "agent",
       "prompt": "Mark the PR ready for review and notify the operator with a short summary.",
       "lead": true
      }
     },
     "ci": {
      "type": "task",
      "name": "CI",
      "performer": {
       "kind": "program",
       "run": "gh",
       "args": [
        "pr",
        "checks",
        "--watch"
       ]
      },
      "mayFail": true
     },
     "merge": {
      "type": "decision",
      "name": "Merge",
      "performer": {
       "kind": "rule",
       "cases": [
        {
         "when": "steps.ci.result == succeeded and params.auto_merge == true",
         "then": "merge"
        }
       ],
       "else": "leave"
      }
     },
     "merge-the-pr": {
      "type": "task",
      "name": "Merge the PR",
      "performer": {
       "kind": "agent",
       "prompt": "Merge the PR now that CI passed.",
       "lead": true
      }
     }
    }
   },
   "edges": [
    {
     "from": "",
     "outcome": "start",
     "to": "start"
    },
    {
     "from": "start",
     "outcome": "next",
     "to": "discuss-the-idea"
    },
    {
     "from": "discuss-the-idea",
     "outcome": "next",
     "to": "idea-decided"
    },
    {
     "from": "idea-decided",
     "outcome": "decided",
     "to": "provision-an-implementor"
    },
    {
     "from": "idea-decided",
     "outcome": "not-yet",
     "to": "discuss-the-idea"
    },
    {
     "from": "provision-an-implementor",
     "outcome": "next",
     "to": "build-the-feature"
    },
    {
     "from": "build-the-feature",
     "outcome": "next",
     "to": "cold-review"
    },
    {
     "from": "cold-review",
     "outcome": "next",
     "to": "iterate-or-move-on"
    },
    {
     "from": "iterate-or-move-on",
     "outcome": "move-on",
     "to": "ready-the-pr"
    },
    {
     "from": "iterate-or-move-on",
     "outcome": "iterate",
     "to": "build-the-feature"
    },
    {
     "from": "iterate-or-move-on",
     "outcome": "give-up",
     "to": "gave-up"
    },
    {
     "from": "ready-the-pr",
     "outcome": "next",
     "to": "ci"
    },
    {
     "from": "ci",
     "outcome": "next",
     "to": "merge"
    },
    {
     "from": "merge",
     "outcome": "merge",
     "to": "merge-the-pr"
    },
    {
     "from": "merge",
     "outcome": "leave",
     "to": "end"
    },
    {
     "from": "merge-the-pr",
     "outcome": "next",
     "to": "end"
    }
   ],
   "layout": {
    "nodes": {}
   }
  },
  "advanced": {
   "template": {
    "apiVersion": "tclaude.dev/v1alpha1",
    "kind": "ProcessTemplate",
    "id": "",
    "name": "Advanced implementation",
    "params": {
     "idea": {
      "type": "string",
      "required": true,
      "description": "The idea to build"
     },
     "allow_amend": {
      "type": "boolean",
      "default": false,
      "description": "The lead may make minor changes to the criteria and design"
     },
     "auto_merge": {
      "type": "boolean",
      "default": false,
      "description": "Merge on green CI without asking"
     }
    },
    "start": "start",
    "nodes": {
     "start": {
      "type": "start"
     },
     "end": {
      "type": "end"
     },
     "discuss-the-idea": {
      "type": "task",
      "name": "Discuss the idea",
      "performer": {
       "kind": "agent",
       "prompt": "Discuss {{params.idea}} with the operator until the high-level idea is clear. Write it down.",
       "lead": true
      }
     },
     "idea-decided": {
      "type": "decision",
      "name": "Idea decided",
      "performer": {
       "kind": "human",
       "ask": "Is the high-level idea decided?",
       "choices": [
        "decided",
        "not-yet"
       ]
