       "kind": "agent",
       "prompt": "Implement the idea on a branch to meet the criteria, and open a draft PR.",
       "role": "implementor"
      }
     },
     "review": {
      "type": "decision",
      "name": "Review",
      "loops": {
       "changes": {
        "maxIterations": 3,
        "onExhausted": "give-up"
       }
      },
      "deciders": [
       {
        "kind": "agent",
        "prompt": "Cold review of the PR, as someone who did not build it. Approve it or ask for changes, with your reasons.",
        "anyone": true,
        "differentFrom": [
         "implement"
        ]
       },
       {
        "kind": "agent",
        "prompt": "Security review of the PR: injection, secrets, permissions. Approve it or ask for changes, with your reasons.",
        "anyone": true,
        "differentFrom": [
         "implement"
        ]
       },
       {
        "kind": "agent",
        "prompt": "Product review of the PR: is the feature usable as the idea meant it? Approve it or ask for changes, with your reasons.",
        "anyone": true,
        "differentFrom": [
         "implement"
        ]
       },
       {
        "kind": "agent",
        "prompt": "Engineering review of the PR: structure, tests, maintainability. Approve it or ask for changes, with your reasons.",
        "anyone": true,
        "differentFrom": [
         "implement"
        ]
       }
      ],
      "agree": "approved"
     },
     "gave-up": {
      "type": "end",
      "name": "Gave up",
      "result": "failed"
     },
     "meets-the-criteria": {
      "type": "decision",
      "name": "Meets the criteria",
      "performer": {
       "kind": "agent",
       "prompt": "Does the implementation, as reviewed, meet the acceptance criteria?",
       "lead": true
      }
     },
     "ready-the-pr": {
      "type": "task",
      "name": "Ready the PR",
      "performer": {
       "kind": "agent",
       "prompt": "Mark the PR ready for review and notify the operator with a short summary.",
       "lead": true
      }
     },
     "ci": {
      "type": "task",
      "name": "CI",
      "performer": {
       "kind": "program",
       "run": "gh",
       "args": [
        "pr",
        "checks",
        "--watch"
       ]
      },
      "mayFail": true
     },
     "merge": {
      "type": "decision",
      "name": "Merge",
      "performer": {
       "kind": "rule",
       "cases": [
        {
         "when": "steps.ci.result == succeeded and params.auto_merge == true",
         "then": "merge"
        }
       ],
       "else": "leave"
      }
     },
     "merge-the-pr": {
      "type": "task",
      "name": "Merge the PR",
      "performer": {
       "kind": "agent",
       "prompt": "Merge the PR now that CI passed.",
       "lead": true
      }
     },
     "amending-allowed": {
      "type": "decision",
      "name": "Amending allowed",
      "performer": {
       "kind": "rule",
       "cases": [
        {
         "when": "params.allow_amend == true",
         "then": "allowed"
        }
       ],
       "else": "rework"
      },
      "loops": {
       "rework": {
        "maxIterations": 3,
        "onExhausted": "give-up"
       }
      }
     },
     "amend-the-criteria": {
      "type": "decision",
      "name": "Amend the criteria",
      "performer": {
       "kind": "agent",
       "prompt": "The operator allows minor changes to the criteria and design. Is the gap minor? Then answer amend; otherwise rework.",
       "lead": true
      },
      "loops": {
       "rework": {
        "maxIterations": 3,
        "onExhausted": "give-up"
       }
      }
     },
     "amend-criteria-and-design": {
      "type": "task",
      "name": "Amend criteria and design",
      "performer": {
       "kind": "agent",
       "prompt": "Make the minor changes to the criteria and the design, and note them for the operator.",
       "lead": true
      }
     },
     "fix-minors-or-proceed": {
      "type": "decision",
      "name": "Fix minors or proceed",
      "performer": {
       "kind": "agent",
       "prompt": "The reviewers approved. Are their minor findings worth fixing first?",
       "lead": true
      }
     },
     "fix-the-minors": {
      "type": "task",
      "name": "Fix the minors",
      "performer": {
       "kind": "agent",
       "prompt": "Fix the minor review findings on the same branch.",
       "role": "implementor",
       "sameAs": "implement"
      }
     }
    }
   },
