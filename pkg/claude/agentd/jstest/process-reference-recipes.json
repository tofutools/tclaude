  "simple-full": {
   "template": {
    "apiVersion": "tclaude.dev/v1alpha1",
    "kind": "ProcessTemplate",
    "id": "",
    "name": "Simple implementation",
    "params": {
     "idea": {
      "type": "string",
      "required": true,
      "description": "The idea to build"
     },
     "auto_merge": {
      "type": "boolean",
      "default": false,
      "description": "Merge on green CI without asking"
     }
    },
    "start": "start",
    "nodes": {
     "start": {
      "type": "start"
     },
     "task": {
      "type": "task",
      "performer": {
       "kind": "agent",
       "prompt": "Discuss {{params.idea}} with the operator until the high-level idea is clear. Write it down.",
       "lead": true
      },
      "name": "Discuss the idea"
     },
     "decision": {
      "type": "decision",
      "name": "Idea decided",
      "performer": {
       "kind": "human",
       "ask": "Is the high-level idea decided?",
       "choices": [
        "decided",
        "not-yet"
       ]
      },
      "loops": {
       "not-yet": {
        "maxIterations": 3
       }
      }
     },
     "task-2": {
      "type": "task",
      "performer": {
       "kind": "agent",
       "prompt": "Bring in an implementor for the idea and brief it.",
       "lead": true
      },
      "name": "Provision an implementor"
     },
     "task-3": {
      "type": "task",
      "performer": {
       "kind": "agent",
       "prompt": "Build the agreed idea on a branch and open a draft PR.",
       "role": "implementor"
      },
      "name": "Build the feature"
     },
     "task-4": {
      "type": "task",
      "performer": {
       "kind": "agent",
       "prompt": "Review the PR cold, as someone who did not build it. List what you find.",
       "anyone": true,
       "differentFrom": [
        "task-3"
       ]
      },
      "name": "Cold review"
     },
     "decision-2": {
      "type": "decision",
      "name": "Iterate or move on",
      "performer": {
       "kind": "agent",
       "prompt": "Does the review warrant another round of changes, or does it move ahead?",
       "lead": true
      },
      "loops": {
       "iterate": {
        "maxIterations": 3,
        "onExhausted": "give-up"
       }
      }
     },
     "end": {
      "type": "end",
      "result": "failed",
      "name": "Gave up"
     },
     "task-5": {
      "type": "task",
      "performer": {
       "kind": "agent",
       "prompt": "Mark the PR ready for review and notify the operator with a short summary.",
       "lead": true
      },
      "name": "Ready the PR"
     },
     "task-6": {
      "type": "task",
      "performer": {
       "kind": "program",
       "run": "gh",
       "args": [
        "pr",
        "checks",
        "--watch"
       ]
      },
      "name": "CI",
      "mayFail": true
     },
     "decision-3": {
      "type": "decision",
      "name": "Merge",
      "performer": {
       "kind": "rule",
       "cases": [
        {
         "when": "steps.task-6.result == succeeded and params.auto_merge == true",
         "then": "merge"
        }
       ],
       "else": "leave"
      }
     },
     "task-7": {
      "type": "task",
      "performer": {
       "kind": "agent",
       "prompt": "Merge the PR now that CI passed.",
       "lead": true
      },
      "name": "Merge the PR"
     },
     "end-2": {
      "type": "end",
      "result": "success"
     }
    }
   },
   "edges": [
    {
     "from": "",
     "outcome": "start",
     "to": "start"
    },
    {
     "from": "start",
     "outcome": "pass",
