{
 "roster": [
  {
   "name": "checkout",
   "id": "agt_a1",
   "role": "dev",
   "online": true,
   "busy": false
  },
  {
   "name": "review-bot",
   "id": "agt_a2",
   "role": "reviewer",
   "online": true,
   "busy": false
  }
 ],
 "starters": {
  "build-review-ship": {
   "template": {
    "apiVersion": "tclaude.dev/v1alpha1",
    "kind": "ProcessTemplate",
    "id": "",
    "name": "build-review-ship",
    "params": {
     "issue": {
      "type": "string",
      "required": true
     }
    },
    "start": "start",
    "nodes": {
     "start": {
      "type": "start"
     },
     "implement": {
      "type": "task",
      "name": "Implement",
      "performer": {
       "kind": "agent",
       "role": "dev",
       "prompt": "Implement {{params.issue}} on a branch and open a PR."
      }
     },
     "review": {
      "type": "task",
      "name": "Review",
      "performer": {
       "kind": "agent",
       "role": "reviewer",
       "prompt": "Review the PR for {{params.issue}} and post your verdict and notes on it."
      }
     },
     "approve": {
      "type": "decision",
      "name": "Approve",
      "performer": {
       "kind": "human",
       "ask": "Ship {{params.issue}}? Read the review on the PR.",
       "choices": [
        "ship",
        "rework",
        "hold"
       ]
      }
     },
     "rework": {
      "type": "task",
      "name": "Rework",
      "performer": {
       "kind": "agent",
       "role": "dev",
       "prompt": "Address the review notes on the PR for {{params.issue}}. This is the one rework round; the human decides next."
      }
     },
     "final-say": {
      "type": "decision",
      "name": "Final say",
      "performer": {
       "kind": "human",
       "ask": "Ship the reworked {{params.issue}}?",
       "choices": [
        "ship",
        "hold"
       ]
      }
     },
     "merge": {
      "type": "task",
      "name": "Merge",
      "performer": {
       "kind": "program",
       "run": "gh",
       "args": [
        "pr",
        "merge",
        "--squash"
       ]
      }
     },
     "end": {
      "type": "end"
     },
     "stopped": {
      "type": "end",
      "result": "canceled",
      "name": "stopped"
     }
    }
   },
   "edges": [
    {
     "from": "",
     "outcome": "start",
     "to": "start"
    },
    {
     "from": "start",
     "outcome": "next",
     "to": "implement"
    },
    {
     "from": "implement",
     "outcome": "next",
     "to": "review"
    },
    {
     "from": "review",
     "outcome": "next",
     "to": "approve"
    },
    {
     "from": "approve",
     "outcome": "ship",
     "to": "merge"
    },
    {
     "from": "approve",
     "outcome": "rework",
     "to": "rework"
    },
    {
     "from": "approve",
     "outcome": "hold",
     "to": "stopped"
    },
    {
     "from": "rework",
     "outcome": "next",
     "to": "final-say"
    },
    {
     "from": "final-say",
     "outcome": "ship",
     "to": "merge"
    },
    {
     "from": "final-say",
     "outcome": "hold",
     "to": "stopped"
    },
    {
     "from": "merge",
     "outcome": "next",
     "to": "end"
    }
   ],
   "layout": {
    "nodes": {}
   }
  },
  "plan-fan-out-merge": {
   "template": {
    "apiVersion": "tclaude.dev/v1alpha1",
    "kind": "ProcessTemplate",
    "id": "",
    "name": "plan-fan-out-merge",
    "params": {
     "goal": {
      "type": "string",
      "required": true
     }
    },
    "start": "start",
    "nodes": {
     "start": {
      "type": "start"
     },
     "plan": {
      "type": "task",
      "name": "Plan",
      "performer": {
       "kind": "agent",
       "prompt": "Plan {{params.goal}} as three independent parts and post them.",
       "assignee": "checkout"
      }
     },
     "fan-out": {
      "type": "parallel",
      "name": "Fan out"
     },
     "integrate": {
      "type": "task",
      "name": "Integrate",
      "join": "all",
      "performer": {
       "kind": "agent",
       "prompt": "Integrate the three parts of {{params.goal}}.",
       "assignee": "checkout"
      }
     },
     "end": {
      "type": "end"
     },
     "part-1": {
      "type": "task",
      "name": "Part 1",
      "performer": {
       "kind": "agent",
       "prompt": "Do part 1 of the plan for {{params.goal}}.",
       "role": "dev"
      }
     },
     "part-2": {
      "type": "task",
      "name": "Part 2",
      "performer": {
       "kind": "agent",
       "prompt": "Do part 2 of the plan for {{params.goal}}.",
       "role": "dev"
      }
     },
     "part-3": {
      "type": "task",
      "name": "Part 3",
      "performer": {
       "kind": "agent",
       "prompt": "Do part 3 of the plan for {{params.goal}}.",
       "role": "dev"
      }
     }
    }
   },
   "edges": [
    {
     "from": "",
     "outcome": "start",
     "to": "start"
    },
    {
     "from": "start",
     "outcome": "next",
     "to": "plan"
    },
    {
     "from": "plan",
     "outcome": "next",
     "to": "fan-out"
    },
    {
     "from": "fan-out",
     "outcome": "part-1",
     "to": "part-1"
    },
    {
     "from": "part-1",
     "outcome": "next",
     "to": "integrate"
    },
    {
     "from": "fan-out",
     "outcome": "part-2",
     "to": "part-2"
    },
    {
     "from": "part-2",
     "outcome": "next",
     "to": "integrate"
    },
    {
     "from": "fan-out",
     "outcome": "part-3",
     "to": "part-3"
    },
    {
     "from": "part-3",
     "outcome": "next",
     "to": "integrate"
    },
    {
     "from": "integrate",
     "outcome": "next",
     "to": "end"
    }
   ],
   "layout": {
    "nodes": {}
   }
  },
  "check-fix": {
   "template": {
    "apiVersion": "tclaude.dev/v1alpha1",
    "kind": "ProcessTemplate",
    "id": "",
    "name": "check-fix",
    "params": {},
    "start": "start",
    "nodes": {
     "start": {
      "type": "start"
     },
     "check-fix": {
      "type": "task",
      "name": "Check & fix",
      "performer": {
       "kind": "agent",
       "role": "dev",
       "prompt": "Run the tests. If any are red, fix them and push; if all are green, say so."
      }
     },
     "verify": {
      "type": "task",
      "name": "Verify",
      "performer": {
       "kind": "program",
       "run": "make",
       "args": [
        "test"
       ]
      }
     },
     "end": {
      "type": "end"
     }
    }
   },
   "edges": [
    {
     "from": "",
     "outcome": "start",
     "to": "start"
    },
    {
     "from": "start",
     "outcome": "next",
     "to": "check-fix"
    },
    {
     "from": "check-fix",
     "outcome": "next",
     "to": "verify"
    },
    {
     "from": "verify",
     "outcome": "next",
     "to": "end"
    }
   ],
   "layout": {
    "nodes": {}
   }
  },
  "ask-me-first": {
   "template": {
    "apiVersion": "tclaude.dev/v1alpha1",
    "kind": "ProcessTemplate",
    "id": "",
    "name": "ask-me-first",
    "params": {
     "task": {
      "type": "string",
      "required": true
     }
    },
    "start": "start",
    "nodes": {
     "start": {
      "type": "start"
     },
     "brief": {
      "type": "decision",
      "name": "Brief",
      "performer": {
       "kind": "human",
       "ask": "Go ahead with {{params.task}}?",
       "choices": [
        "go",
        "stop"
       ]
      }
     },
     "do-it": {
      "type": "task",
      "name": "Do it",
      "performer": {
       "kind": "agent",
       "role": "dev",
       "prompt": "Do {{params.task}}."
      }
     },
     "accept": {
      "type": "decision",
      "name": "Accept",
      "performer": {
       "kind": "human",
       "ask": "Accept the result of {{params.task}}?",
       "choices": [
        "accept",
        "rework"
       ]
      }
     },
     "rework": {
      "type": "task",
      "name": "Rework",
      "performer": {
       "kind": "agent",
       "role": "dev",
       "prompt": "The human asked for a rework of {{params.task}}. This is the one rework round."
      }
     },
     "final-say": {
      "type": "decision",
      "name": "Final say",
      "performer": {
       "kind": "human",
       "ask": "Accept the reworked {{params.task}}?",
       "choices": [
        "accept",
        "reject"
       ]
      }
     },
     "end": {
      "type": "end"
     },
     "stopped": {
      "type": "end",
      "result": "canceled",
      "name": "stopped"
     }
    }
   },
   "edges": [
    {
     "from": "",
     "outcome": "start",
     "to": "start"
    },
    {
     "from": "start",
     "outcome": "next",
     "to": "brief"
    },
    {
     "from": "brief",
     "outcome": "go",
     "to": "do-it"
    },
    {
     "from": "brief",
     "outcome": "stop",
     "to": "stopped"
    },
    {
     "from": "do-it",
     "outcome": "next",
     "to": "accept"
    },
    {
     "from": "accept",
     "outcome": "accept",
     "to": "end"
    },
    {
     "from": "accept",
     "outcome": "rework",
     "to": "rework"
    },
    {
     "from": "rework",
     "outcome": "next",
     "to": "final-say"
    },
    {
     "from": "final-say",
     "outcome": "accept",
     "to": "end"
    },
    {
     "from": "final-say",
     "outcome": "reject",
     "to": "stopped"
    }
   ],
   "layout": {
    "nodes": {}
   }
  }
 }
}
