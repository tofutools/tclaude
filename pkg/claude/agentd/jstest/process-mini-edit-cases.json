{
 "cases": {
  "after-implement-agent": {
   "template": {
    "apiVersion": "tclaude.dev/v1alpha1",
    "kind": "ProcessTemplate",
    "id": "",
    "name": "build-review-ship",
    "params": {
     "issue": {
      "type": "string",
      "required": true
     }
    },
    "start": "start",
    "nodes": {
     "start": {
      "type": "start"
     },
     "implement": {
      "type": "task",
      "name": "Implement",
      "performer": {
       "kind": "agent",
       "role": "dev",
       "prompt": "Implement {{params.issue}} on a branch and open a PR. When it comes back for changes, address the notes on the same PR."
      }
     },
     "review": {
      "type": "task",
      "name": "Review",
      "performer": {
       "kind": "agent",
       "role": "reviewer",
       "prompt": "Review the PR for {{params.issue}} and post your verdict and notes on it."
      }
     },
     "approve": {
      "type": "decision",
      "name": "Approve",
      "performer": {
       "kind": "human",
       "ask": "Ship {{params.issue}}? Read the review on the PR.",
       "choices": [
        "ship",
        "changes",
        "hold"
       ]
      },
      "loops": {
       "changes": {
        "maxIterations": 3,
        "onExhausted": "hold"
       }
      }
     },
     "merge": {
      "type": "task",
      "name": "Merge",
      "performer": {
       "kind": "program",
       "run": "gh",
       "args": [
        "pr",
        "merge",
        "--squash"
       ]
      }
     },
     "end": {
      "type": "end"
     },
     "stopped": {
      "type": "end",
      "result": "canceled",
      "name": "stopped"
     },
     "new-step": {
      "type": "task",
      "name": "New step",
      "performer": {
       "kind": "agent",
       "prompt": "Do the thing."
      }
     }
    }
   },
   "edges": [
    {
     "from": "",
     "outcome": "start",
     "to": "start"
    },
    {
     "from": "start",
     "outcome": "next",
     "to": "implement"
    },
    {
     "from": "implement",
     "outcome": "next",
     "to": "new-step"
    },
    {
     "from": "review",
     "outcome": "next",
     "to": "approve"
    },
    {
     "from": "approve",
     "outcome": "ship",
     "to": "merge"
    },
    {
     "from": "approve",
     "outcome": "changes",
     "to": "implement"
    },
    {
     "from": "approve",
     "outcome": "hold",
     "to": "stopped"
    },
    {
     "from": "merge",
     "outcome": "next",
     "to": "end"
    },
    {
     "from": "new-step",
     "outcome": "next",
     "to": "review"
    }
   ],
   "layout": {
    "nodes": {}
   }
  },
  "after-start-you": {
   "template": {
    "apiVersion": "tclaude.dev/v1alpha1",
