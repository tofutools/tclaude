       "kind": "agent",
       "role": "dev",
       "prompt": "Implement {{params.issue}} on a branch and open a PR. When it comes back for changes, address the notes on the same PR."
      }
     },
     "review": {
      "type": "task",
      "name": "Review",
      "performer": {
       "kind": "agent",
       "role": "reviewer",
       "prompt": "Review the PR for {{params.issue}} and post your verdict and notes on it."
      }
     },
     "approve": {
      "type": "decision",
      "name": "Approve",
      "performer": {
       "kind": "human",
       "ask": "Ship {{params.issue}}? Read the review on the PR.",
       "choices": [
        "ship",
        "changes",
        "hold"
       ]
      },
      "loops": {
       "changes": {
        "maxIterations": 3,
        "onExhausted": "hold"
       }
      }
     },
     "merge": {
      "type": "task",
      "name": "Merge",
      "performer": {
       "kind": "program",
       "run": "gh",
       "args": [
        "pr",
        "merge",
        "--squash"
       ]
      }
     },
     "end": {
      "type": "end"
     },
     "stopped": {
      "type": "end",
      "result": "canceled",
      "name": "stopped"
     },
     "decide": {
      "type": "decision",
      "name": "Decide",
      "performer": {
       "kind": "human",
       "ask": "Do the thing.",
       "choices": [
        "continue"
       ]
      }
     }
    }
